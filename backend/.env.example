# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
PORT=5001

# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here

# RAG Settings (for future modules)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
DEFAULT_TOP_K=5
CROSS_ENCODER_MODEL=ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SEMANTIC_THRESHOLD=0.6
BM25_DEFAULT_TOP_K=5
BM25_TOKENIZER=whitespace_lower
BM25_MAX_QUERY_LENGTH=1000
HYBRID_RRF_K=60
HYBRID_DEFAULT_TOP_K=5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5
RERANK_BATCH_SIZE=32

# Prompt Builder Configuration
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARACTERS=4000
PROMPT_TEMPLATE_VERSION=rag_prompt_v1
PROMPT_VERSION=1.0.0
PIPELINE_VERSION=1.0.0

# Additional NVIDIA LLM Generation Settings
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT=60
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.7

# Optimization & Caching Settings
RERANK_CANDIDATE_POOL=20
CACHE_ENABLED=True




