# ======================================================
# Evidence-Grounded AI Research Assistant - Backend Environment Variables
# ======================================================

# Server Configuration
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0

# Startup Performance & Memory Configuration (Set False for Render Free 512MB RAM)
ENABLE_WARMUP=False

# Security Keys
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production

# Database Setting (PostgreSQL Connection String)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: For passwords containing special characters (e.g. @), URL-encode them (e.g. %40)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_rag
SQLALCHEMY_TRACK_MODIFICATIONS=False

# NVIDIA NIM API (LLM Generation)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
LLM_TIMEOUT=60
LLM_MAX_TOKENS=384
LLM_TEMPERATURE=0.2

# Firebase Authentication Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# File Upload Configuration
UPLOAD_FOLDER=data/raw
MAX_CONTENT_LENGTH=10485760

# RAG & Retrieval Pipeline Parameters
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SEMANTIC_THRESHOLD=0.6
HYBRID_RRF_K=60
DEFAULT_TOP_K=5
CACHE_ENABLED=True
EVALUATION_ENABLED=True
